# Banco de dados Postgres (DigitalOcean Managed Database ou local)
# Em produção o DigitalOcean fornece esta string; adicione ?sslmode=require no fim.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bolao?schema=public"

# Chave da API football-data.org (gratuita): https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=""

# Segredo do cookie de sessão (mínimo 32 caracteres). Gere com: openssl rand -base64 32
SESSION_SECRET="troque-isto-por-uma-string-aleatoria-de-32+chars"

# Segredo que protege o endpoint /api/sync (usado pelo cron). Gere outro valor aleatório.
SYNC_SECRET="troque-isto-tambem-por-um-valor-aleatorio"

# Nome do usuário administrador criado pelo seed (você).
ADMIN_USERNAME="carlos"
