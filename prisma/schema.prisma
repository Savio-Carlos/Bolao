// Schema do bolão da Copa do Mundo 2026
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  isAdmin       Boolean        @default(false)
  createdAt     DateTime       @default(now())
  predictions   Prediction[]
  tournamentBet TournamentBet?
}

// Palpites de longo prazo de cada pessoa (um conjunto por usuário), feitos antes
// da Copa e valendo bônus. Corrigidos quando o admin grava o TournamentResult.
model TournamentBet {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  champion   String?
  runnerUp   String?
  topScorer  String?
  bestPlayer String?
  upsetTeam  String? // "maior zebra": seleção
  upsetStage String? // "maior zebra": fase em que ela é eliminada
  points     Int? // total após a correção do admin
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Configurações globais do app (linha única, id = 1).
model AppSettings {
  id Int @id @default(1)
  // Suspense do bolão: a partir do início das semifinais o ranking e os palpites
  // dos jogos finais ficam "congelados" até o admin revelar o resultado.
  rankingRevealed Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

// Gabarito oficial (linha única, id = 1) preenchido pelo admin ao fim da Copa.
model TournamentResult {
  id         Int      @id @default(1)
  champion   String?
  runnerUp   String?
  topScorer  String?
  bestPlayer String?
  upsetTeam  String?
  upsetStage String?
  updatedAt  DateTime @updatedAt
}

model Match {
  id          Int          @id @default(autoincrement())
  externalId  Int          @unique
  // stage/status/winner são String (não enum) para o sync não quebrar caso a
  // API envie um valor inesperado. A ordem de exibição é controlada no código.
  stage       String // GROUP_STAGE, LAST_32, LAST_16, QUARTER_FINALS, SEMI_FINALS, THIRD_PLACE, FINAL
  group       String? // GROUP_A ... GROUP_L (só na fase de grupos)
  homeTeam    String? // null no mata-mata enquanto o time não é definido
  awayTeam    String?
  homeCrest   String?
  awayCrest   String?
  kickoff     DateTime
  status      String       @default("SCHEDULED") // SCHEDULED, TIMED, IN_PLAY, PAUSED, FINISHED, ...
  homeScore   Int?
  awayScore   Int?
  winner      String? // HOME, AWAY, DRAW — resultado do tempo normal/prorrogação
  // Quem avançou no mata-mata (inclui decisão por pênaltis). null na fase de
  // grupos e enquanto o jogo não é decidido. Pode diferir de winner (ex.: 1×1
  // nos 90' e classificação nos pênaltis -> winner=DRAW, advancer=HOME/AWAY).
  advancer    String? // HOME, AWAY
  updatedAt   DateTime     @updatedAt
  predictions Prediction[]

  @@index([kickoff])
}

model Prediction {
  id        Int      @id @default(autoincrement())
  userId    Int
  matchId   Int
  homeScore Int
  awayScore Int
  points    Int?
  // Mata-mata: palpite de quem avança (HOME/AWAY) e o bônus por acertá-lo.
  // Independente do placar — vale mesmo quando o jogo vai aos pênaltis.
  advancePick   String? // HOME, AWAY
  advancePoints Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
}
